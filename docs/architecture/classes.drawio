        <object id="part-engine~type-GameEngine" label="&lt;div style=&quot;padding-top:4px;text-align:center;line-height:16px;&quot;&gt;&lt;span style=&quot;font-size:11px;&quot;&gt;«aggregate root»&lt;/span&gt;&lt;br&gt;&lt;b&gt;GameEngine&lt;/b&gt;&lt;/div&gt;&lt;hr style=&quot;margin:4px 0;border:none;border-top:1px solid #b45309;&quot;&gt;&lt;div style=&quot;padding:0 10px;line-height:16px;&quot;&gt;- state: TState | undefined&lt;br&gt;- current: GamePhase&lt;br&gt;- recorded: GameEvent[]&lt;br&gt;- matchId: MatchId&lt;br&gt;- gameId: GameId&lt;br&gt;- rules: IGameRules&amp;lt;TMove, TState&amp;gt;&lt;br&gt;- scoring: IScoringPolicy&amp;lt;TState&amp;gt;&lt;br&gt;- history?: IUndoable&amp;lt;TMove, SnapshotOf&amp;lt;TState&amp;gt;&amp;gt;&lt;br&gt;- timer?: ITimed&lt;br&gt;- levelId?: LevelId&lt;/div&gt;&lt;hr style=&quot;margin:4px 0;border:none;border-top:1px solid #b45309;&quot;&gt;&lt;div style=&quot;padding:0 10px;line-height:16px;&quot;&gt;+ constructor(matchId: MatchId, gameId: GameId, rules: IGameRules&amp;lt;&lt;br class=&quot;wrap&quot;&gt;    TMove, TState&amp;gt;, scoring: IScoringPolicy&amp;lt;TState&amp;gt;,&lt;br class=&quot;wrap&quot;&gt;    history?: IUndoable&amp;lt;TMove, SnapshotOf&amp;lt;TState&amp;gt;&amp;gt;, timer?: ITimed,&lt;br class=&quot;wrap&quot;&gt;    levelId?: LevelId)&lt;br&gt;+ equals(other: GameEngine&amp;lt;TCell, TCoord, TMove, TState&amp;gt;): boolean&lt;br&gt;+ currentPhase(): GamePhase&lt;br&gt;+ start(initial: TState): void&lt;br&gt;+ undo(): void&lt;br&gt;+ redo(): void&lt;br&gt;+ canUndo(): boolean&lt;br&gt;+ canRedo(): boolean&lt;br&gt;+ offersUndo(): boolean&lt;br&gt;+ elapsedTime(): ElapsedTime | undefined&lt;br&gt;+ levelOfMatch(): LevelId | undefined&lt;br&gt;+ tryPlay(move: TMove): Resolution&lt;br&gt;+ takeEvents(): readonly GameEvent[]&lt;br&gt;+ pause(): void&lt;br&gt;+ resume(): void&lt;br&gt;+ snapshot(): SnapshotOf&amp;lt;TState&amp;gt;&lt;br&gt;- resolveTurn(state: TState, move: TMove): | { next: TState;&lt;br class=&quot;wrap&quot;&gt;    phase: GamePhase; outcome: Outcome; before: SnapshotOf&amp;lt;TState&amp;gt;;&lt;br class=&quot;wrap&quot;&gt;    after: SnapshotOf&amp;lt;TState&amp;gt;; events: readonly GameEvent[]; }&lt;br class=&quot;wrap&quot;&gt;    | undefined&lt;br&gt;- gameEndedOf(next: TState, resolution: Resolution): GameEnded&lt;br class=&quot;wrap&quot;&gt;    | undefined&lt;br&gt;- remember(move: TMove, before: SnapshotOf&amp;lt;TState&amp;gt;, after: SnapshotOf&amp;lt;&lt;br class=&quot;wrap&quot;&gt;    TState&amp;gt;): void&lt;br&gt;- restore(memento: SnapshotOf&amp;lt;TState&amp;gt;): void&lt;br&gt;- started(): TState&lt;br&gt;- redoCapability(): IRedoable&lt;/div&gt;" role="class" typeId="GameEngine" kind="class" status="code" layer="1"><mxCell style="rounded=0;whiteSpace=wrap;html=1;overflow=fill;verticalAlign=top;align=left;spacing=0;fontSize=12;fontColor=#111827;fillColor=#ffffff;strokeColor=#b45309;strokeWidth=1.5;" vertex="1" parent="part-engine~band-1"><mxGeometry x="78" y="172" width="488" height="702" as="geometry"/></mxCell></object>
