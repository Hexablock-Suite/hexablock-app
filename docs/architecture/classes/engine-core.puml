@startuml engine-core
' HexaBlock Suite class diagram, part 1: the generic engine.
' Every class here lives in layer 1 (entities), src/domain/engine/.
' Color marks the Clean layer. A stereotype marks the role of a class in a GoF pattern.
' Render: see docs/architecture/classes.md.

title HexaBlock Suite: generic engine (layer 1, src/domain/engine/)

' A dot in a package name is text, not a namespace separator.
set separator none

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 50
skinparam class {
  BackgroundColor #FEF3C7
  BorderColor #B45309
  ArrowColor #374151
  StereotypeFontColor #7C2D12
}
skinparam package {
  BackgroundColor #FFFBEB
  BorderColor #D97706
  FontColor #7C2D12
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #9CA3AF
}
skinparam legend {
  BackgroundColor #FFFFFF
  BorderColor #9CA3AF
}
hide empty members

legend top left
  Yellow: layer 1, entities (src/domain/engine/). The engine imports no variant and no framework.
  Dashed box at the top right of a class: its type parameters (UML template).
  <<Strategy>>, <<Command>> and so on: the role of the class in a GoF pattern.
  <<port>>: an interface that an outer layer implements (see layers.md).
  Every class is planned. src/domain/engine/ holds only a README today.
endlegend

package "Shared values" {
  class GameId <<value object>> {
    +value: "lines" | "fit" | "sort" | "merge"
  }
  class Color <<value object>> {
    +name: string
  }
}

package "Board and geometry (Iterator, D4)" {
  class HexCoord <<value object>> {
    +q: number
    +r: number
    +add(other: HexCoord): HexCoord
    +equals(other: HexCoord): boolean
  }
  interface GridTopology <<Strategy>> {
    +rotationSteps: number
    +neighbors(c: HexCoord): HexCoord[]
    +directions(): Direction[]
    +axes(): Axis[]
    +rotate(c: HexCoord, steps: number): HexCoord
  }
  class HexTopology {
    6 directions, 3 axes, 60 degree steps
  }
  class SquareTopology <<test double>> {
    4 directions, 2 axes, 90 degree steps
  }
  class BoardShape <<value object>> {
    +cells: HexCoord[]
    +{static} hexagon(radius: number): BoardShape
    +{static} fromShape(shape: ShapeNode): BoardShape
  }
  class HexBoard<TCell> <<Iterator>> <<Prototype>> {
    -cells: Map<string, TCell>
    +shape: BoardShape
    +topology: GridTopology
    +get(c: HexCoord): TCell | undefined
    +set(c: HexCoord, cell: TCell): void
    +line(axis: Axis, through: HexCoord): Iterable<HexCoord>
    +ring(center: HexCoord, radius: number): Iterable<HexCoord>
    +neighborhood(c: HexCoord): Iterable<HexCoord>
    +clone(): HexBoard<TCell>
  }
}

package "Pieces and figures (Composite, Prototype)" {
  interface ShapeNode <<Component>> {
    +cells(): HexCoord[]
    +area(): number
    +rotated(steps: number, topology: GridTopology): ShapeNode
    +translated(offset: HexCoord): ShapeNode
  }
  class CellNode <<Leaf>> {
    +at: HexCoord
  }
  class ShapeGroup <<Composite>> {
    +children: ShapeNode[]
  }
  class Piece<TCell> <<Prototype>> {
    +shape: ShapeNode
    +content: TCell
    +rotated(steps: number): Piece<TCell>
    +clone(): Piece<TCell>
  }
  interface Cloneable<T> <<Prototype>> {
    +clone(): T
  }
}

package "Turn (Template Method and Strategy, D1)" {
  interface BoardState<TCell> {
    +board: HexBoard<TCell>
    +score: number
    +clone(): BoardState<TCell>
  }
  interface IGameRules<TCell, TMove, TState> <<Strategy>> {
    +isValid(state: TState, move: TMove): boolean
    +apply(state: TState, move: TMove): TState
    +resolve(state: TState): Resolution<TState>
    +evaluate(state: TState): Outcome
  }
  class GameEngine<TCell, TMove, TState> <<Template Method>> {
    -rules: IGameRules<TCell, TMove, TState>
    -scoring: IScoringPolicy<TState>
    -events: GameEventPublisher
    -phase: GamePhase
    -history: MoveHistory<TMove, TState> [0..1]
    +state: TState
    +start(initial: TState): void
    +play(move: TMove): Outcome
    +pause(): void
    +resume(): void
  }
  class Resolution<TState> <<value object>> {
    +state: TState
    +events: GameEvent[]
  }
  enum Outcome {
    CONTINUE
    VICTORY
    DEFEAT
  }
}

package "Game lifecycle (State, D2)" {
  interface GamePhase <<State>> {
    +canPlay(): boolean
    +pause(): GamePhase
    +resume(): GamePhase
    +after(outcome: Outcome): GamePhase
  }
  class PlayingPhase
  class ResolvingPhase
  class PausedPhase
  class GameOverPhase
  class VictoryPhase
}

package "Move history (Command)" {
  class MoveCommand<TMove, TState> <<Command>> {
    +move: TMove
    -before: TState
    -after: TState
    +undo(): TState
    +redo(): TState
  }
  class MoveHistory<TMove, TState> <<Invoker>> {
    -done: MoveCommand[]
    +limit: number [0..1]
    +record(command: MoveCommand<TMove, TState>): void
  }
  class RedoableHistory<TMove, TState> {
    -undone: MoveCommand[]
  }
}

package "Capabilities (ISP, statement 3.2)" {
  interface IUndoable {
    +canUndo(): boolean
    +undo(): void
  }
  interface IRedoable {
    +canRedo(): boolean
    +redo(): void
  }
  interface ITimed {
    +elapsedMs(): number
  }
  interface IRandomSeeded {
    +seed: number
  }
  interface IMergeable<T> {
    +canMergeWith(other: T): boolean
    +mergeWith(other: T): T
  }
  class LevelTimer {
    -clock: Clock
    -startedAt: number
  }
}

package "Piece sources (Strategy)" {
  interface IPieceSource<TPiece> <<Strategy>> {
    +hasNext(): boolean
    +next(): TPiece
  }
  class SeededPieceSource<TPiece> {
    -random: RandomSource
    -draw: (random: RandomSource) => TPiece
  }
  class FixedListPieceSource<TPiece> {
    -pieces: TPiece[]
  }
}

package "Scoring and progress (Strategy, Decorator)" {
  interface IScoringPolicy<TState> <<Strategy>> {
    +score(before: TState, resolution: Resolution<TState>): number
  }
  abstract class ScoringDecorator<TState> <<Decorator>> {
    #inner: IScoringPolicy<TState>
  }
  interface IProgressModel <<Strategy>> {
    +record(result: GameResult): ProgressRecord
  }
  class HighScoreProgress
  class LevelProgress {
    stars for Fit, plain levels for Sort
  }
  class GameResult <<value object>> {
    +gameId: GameId
    +levelId: string [0..1]
    +score: number
    +moves: number
    +elapsedMs: number [0..1]
  }
  class ProgressRecord <<value object>>
}

package "Levels (Builder, A5)" {
  interface ILevelBuilder<TLevel> <<Builder>> {
    +build(): TLevel
  }
}

package "Game events (Observer)" {
  interface GameEventPublisher <<port>> {
    +publish(event: GameEvent): void
  }
  abstract class GameEvent <<value object>> {
    +gameId: GameId
  }
  class GameOver {
    +outcome: Outcome
    +finalScore: number
  }
}

package "Ports" {
  interface Clock <<port>> {
    +now(): number
  }
  interface RandomSource <<port>> {
    +next(): number
  }
}

package "Variant factory (Abstract Factory)" {
  interface IVariantFactory<TCell, TMove, TState> <<Abstract Factory>> {
    +gameId: GameId
    +createRules(): IGameRules<TCell, TMove, TState>
    +createScoring(): IScoringPolicy<TState>
    +createProgressModel(): IProgressModel
    +createInitialState(): TState
    +createHistory(): MoveHistory<TMove, TState> [0..1]
  }
}

' Board and geometry
GridTopology <|.. HexTopology
GridTopology <|.. SquareTopology
HexBoard *-- BoardShape
HexBoard --> GridTopology
BoardShape ..> ShapeNode : builds from
HexBoard ..|> Cloneable

' Pieces
ShapeNode <|.. CellNode
ShapeNode <|.. ShapeGroup
ShapeGroup o-- "1..*" ShapeNode : children
Piece *-- ShapeNode
Piece ..|> Cloneable
BoardState --|> Cloneable

' Turn
GameEngine --> IGameRules : steps
GameEngine --> IScoringPolicy
GameEngine --> GameEventPublisher : notify
GameEngine *-- GamePhase : phase
GameEngine o-- "0..1" MoveHistory : history
GameEngine ..> MoveCommand : creates
GameEngine ..> BoardState : TState bound
IGameRules ..> Resolution
IGameRules ..> Outcome

' Lifecycle
GamePhase <|.. PlayingPhase
GamePhase <|.. ResolvingPhase
GamePhase <|.. PausedPhase
GamePhase <|.. GameOverPhase
GamePhase <|.. VictoryPhase

' History
MoveHistory o-- MoveCommand
MoveHistory ..|> IUndoable
RedoableHistory --|> MoveHistory
RedoableHistory ..|> IRedoable

' Capabilities and ports
LevelTimer ..|> ITimed
LevelTimer --> Clock
IPieceSource <|.. SeededPieceSource
IPieceSource <|.. FixedListPieceSource
SeededPieceSource ..|> IRandomSeeded
SeededPieceSource --> RandomSource

' Scoring and progress
IScoringPolicy <|.. ScoringDecorator
ScoringDecorator o-- IScoringPolicy : inner
IProgressModel <|.. HighScoreProgress
IProgressModel <|.. LevelProgress
IProgressModel ..> GameResult
IProgressModel ..> ProgressRecord

' Events
GameEvent <|-- GameOver

' Factory
IVariantFactory ..> IGameRules : creates
IVariantFactory ..> IScoringPolicy : creates
IVariantFactory ..> IProgressModel : creates
IVariantFactory ..> MoveHistory : creates

' Layout only: hidden links stack the packages in three rows.
HexTopology -[hidden]down-> GameEngine
CellNode -[hidden]down-> GamePhase
Color -[hidden]down-> MoveHistory
HexCoord -[hidden]down-> IUndoable
Resolution -[hidden]down-> IVariantFactory
PlayingPhase -[hidden]down-> IScoringPolicy
RedoableHistory -[hidden]down-> IPieceSource
LevelTimer -[hidden]down-> GameEventPublisher
IMergeable -[hidden]down-> Clock
IUndoable -[hidden]down-> ILevelBuilder

note bottom of GameEngine
  play() is the template method (D1):
  phase.canPlay, rules.isValid, history.record,
  rules.apply, rules.resolve, scoring.score,
  rules.evaluate, phase.after, events.publish.
  The steps come from IGameRules (Strategy).
  TState extends BoardState<TCell>: the bounded
  generic gives the engine the board and the score.
end note

note bottom of GameEventPublisher
  Observer: GameEventBus in layer 3 implements
  this port. Presenters, the score display and
  the audio facade subscribe to the bus.
end note

note bottom of IMergeable
  Bound of the Merge rules:
  MergeRules<TCell extends IMergeable<TCell>>
  (statement 3.1, A1). See part 2.
end note
@enduml
