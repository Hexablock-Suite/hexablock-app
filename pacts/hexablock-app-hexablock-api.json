        }
      ],
      "request": {
        "body": {
          "content": {
            "password": "short",
            "username": "ada"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "method": "POST",
        "path": "/v1/auth/register"
      },
      "response": {
