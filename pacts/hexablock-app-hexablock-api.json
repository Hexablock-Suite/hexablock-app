    },
    {
      "description": "the signed-in user",
      "pending": false,
      "providerStates": [
        {
          "name": "a signed-in account exists",
          "params": {
            "username": "ada"
          }
        }
      ],
      "request": {
        "generators": {
          "header": {
            "Authorization": {
              "expression": "Bearer ${accessToken}",
              "type": "ProviderState"
            }
          }
        },
        "headers": {
          "Authorization": [
            "Bearer a-token"
          ]
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/v1/auth/me"
      },
      "response": {
        "body": {
          "content": {
            "userId": "00000000-0000-4000-8000-000000000001"
          },
          "contentType": "application/json",
          "encoded": false
        },
        "headers": {
          "Content-Type": [
            "application/json"
          ]
        },
        "matchingRules": {
          "body": {
            "$.userId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            }
          }
        },
        "status": 200
      },
      "type": "Synchronous/HTTP"
    }
  ],
  "metadata": {
